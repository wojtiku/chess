{
  "name": "chess-practice-board",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "A browser chess practice board: play White against a computer opponent and review your games.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "perft:full": "PERFT_FULL=1 vitest run src/test/perft.test.ts",
    "e2e": "playwright test",
    "copy-engine": "node scripts/copy-engine.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stockfish": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
